# Copy to .env (never committed). Nothing here is needed for the core notebook:
# Planetary Computer's Sentinel-2 and Copernicus DEM collections need no account.

# Bonus A: the LLM that calls the MCP tool. Set ONE provider.
LLM_PROVIDER=openai            # openai | anthropic | deepseek | kimi
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=              # used through the OpenAI-compatible endpoint
KIMI_API_KEY=                  # used through the OpenAI-compatible endpoint
LLM_MODEL=                     # optional override of the provider default
