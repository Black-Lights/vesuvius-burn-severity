# Copy to .env (never committed). Nothing here is needed for the core notebook:
# Planetary Computer's Sentinel-2 and Copernicus DEM collections need no account.

# Bonus A: the model that calls the MCP tools, any chat model served in the OpenAI format.
# LLM_PROVIDER is deepseek, kimi, openai or custom.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
KIMI_API_KEY=
OPENAI_API_KEY=
# Optional: a model other than the provider's default.
LLM_MODEL=
# custom: any OpenAI-compatible endpoint, for example a self-hosted model served with vLLM.
LLM_BASE_URL=
LLM_API_KEY=
